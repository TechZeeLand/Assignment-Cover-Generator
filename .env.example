# Copy to .env (next to docker-compose.yml) before `docker compose up`.
TZL_ROOT_DOMAIN=rayaz.org
TZL_BASE_URL=https://assignmentcovergenerator.rayaz.org
TZL_TRUST_PROXY=1
TZL_ADMIN_USER=admin
# Leave empty to get a random password in `docker compose logs` on first start.
# An existing install keeps its current admin password (the user name is "admin").
TZL_ADMIN_PASSWORD=
# Lost the password? Set both of these once, restart, then remove them again:
# ADMIN_PASSWORD=a-new-long-password
# ADMIN_PASSWORD_RESET=1
